{{.SiteDomains}} {
    header {
        -Server
        -X-Powered-By
        Strict-Transport-Security "max-age=15768000"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    encode zstd gzip
    root * {{quote .AssetRoot}}
    # Secrets and repository metadata must never be served as static files.
    @private path /.env /.env.* /.git /.git/*
    handle @private {
        respond 404
    }
    @assets {
        method GET HEAD
        path {{.AssetPath}}/*
        file {path}
    }
    # Reserved build paths never fall through to application workers.
    @buildAssets path {{.AssetPath}} {{.AssetPath}}/*
    handle @buildAssets {
        handle @assets {
            # Only content-hashed build assets get immutable caching.
            @versioned path_regexp versioned ^/(build/assets/.*[-.][A-Za-z0-9_-]{8,}|_nuxt/(.*[-.])?[A-Za-z0-9_-]{8,})\.(js|css|woff2?|ttf|otf|svg|png|webp|avif|jpe?g|gif|wasm)$
            header @versioned Cache-Control "public, max-age=31536000, immutable" {
                match status 200 206 304
            }
            file_server {
                precompressed br zstd gzip
            }
        }
        handle {
            respond 404
        }
    }
    handle {
{{if eq .Type "laravel"}}
{{if eq .WebDriver "fpm"}}
        php_fastcgi unix/{{.FPMSocket}}
        file_server {
            precompressed br zstd gzip
        }
{{else}}
        reverse_proxy 127.0.0.1:{{.OctaneHTTPPort}}
{{end}}
{{else}}
        reverse_proxy 127.0.0.1:{{.NuxtHTTPPort}}
{{end}}
    }
    handle_errors {
        header {
            -Server
            -X-Powered-By
            Strict-Transport-Security "max-age=15768000"
            X-Frame-Options "SAMEORIGIN"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
        }
        respond "{err.status_code}" {err.status_code}
    }
}
# Explicit HTTP routes also remove identifying headers from HTTPS redirects.
{{.HTTPDomains}} {
    header -Server
    redir https://{host}{uri} 308
}
{{range .Aliases}}
{{.}} {
    header {
        -Server
        -X-Powered-By
        Strict-Transport-Security "max-age=15768000"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    redir https://{{$.Domain}}{uri} 308
}
http://{{.}} {
    header -Server
    redir https://{{$.Domain}}{uri} 308
}
{{end}}
