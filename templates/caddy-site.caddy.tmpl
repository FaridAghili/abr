{{.SiteDomains}} {
    header {
        -Server
        -Via
        -X-Powered-By
        Strict-Transport-Security "max-age=15768000"
{{if not .EmbedPaths}}
        X-Frame-Options "SAMEORIGIN"
{{end}}
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
{{if .EmbedPaths}}
    @embeddable path{{range .EmbedPaths}} {{quote .}}{{end}}
    @frameProtected not path{{range .EmbedPaths}} {{quote .}}{{end}}
    header @frameProtected >X-Frame-Options "SAMEORIGIN"
    header @embeddable {
        -X-Frame-Options
        # Keep other application CSP directives; policies are enforced together.
        +Content-Security-Policy {{quote .FrameAncestors}}
    }
{{end}}
    encode zstd gzip
    root {{quote .AssetRoot}}
    # Secrets and repository metadata must never be served as static files.
    @private path /.env /.env.* /.git /.git/*
    handle @private {
        respond 404
    }
    @assets {
        method GET HEAD
        path {{.AssetPath}}/*
        file {path}
    }
    # Query strings, hex hashes, UUIDs and mixed-case/random build tokens
    # identify versioned URLs. Plain lowercase names remain stable filenames.
    @versioned expression `{query} != "" || path_regexp('(?i)(^|/|[-._])[a-f0-9]{8,}([-._/]|$)') || {path}.split('/').exists(segment, segment.split('.').exists(token, token.size() >= 8 && token.matches('^[A-Za-z0-9_-]+$') && token.matches('.*[0-9A-Z].*')))`
    vars @versioned assetVersioned true
    @staticFiles {
        method GET HEAD
        path_regexp staticFiles (?i)\.(css|m?js|cjs|woff2?|ttf|otf|eot|ttc|sfnt|png|jpe?g|gif|webp|avif|svgz?|ico|bmp|tiff?|apng|jxl|heic|heif)$
        file {path}
    }
    @versionedStatic {
        method GET HEAD
        path_regexp versionedStatic (?i)\.(css|m?js|cjs|woff2?|ttf|otf|eot|ttc|sfnt|png|jpe?g|gif|webp|avif|svgz?|ico|bmp|tiff?|apng|jxl|heic|heif)$
        file {path}
        vars assetVersioned true
    }
    @stableStatic {
        method GET HEAD
        path_regexp stableStatic (?i)\.(css|m?js|cjs|woff2?|ttf|otf|eot|ttc|sfnt|png|jpe?g|gif|webp|avif|svgz?|ico|bmp|tiff?|apng|jxl|heic|heif)$
        file {path}
        not vars assetVersioned true
    }
    # Cache only existing public data/download files, never PHP/HTML or APIs.
    @otherFiles {
        method GET HEAD
        path_regexp otherFiles (?i)\.(json|xml|txt|csv|pdf|map|webmanifest|wasm|mp4|webm|mp3|ogg|wav|zip)$
        file {path}
    }
    @versionedOther {
        method GET HEAD
        path_regexp versionedOther (?i)\.(json|xml|txt|csv|pdf|map|webmanifest|wasm|mp4|webm|mp3|ogg|wav|zip)$
        file {path}
        vars assetVersioned true
    }
    @stableOther {
        method GET HEAD
        path_regexp stableOther (?i)\.(json|xml|txt|csv|pdf|map|webmanifest|wasm|mp4|webm|mp3|ogg|wav|zip)$
        file {path}
        not vars assetVersioned true
    }
    header @versionedStatic {
        Cache-Control "public, max-age=31536000, immutable"
        match status 200 206 304
    }
    header @stableStatic {
        Cache-Control "public, max-age=2592000"
        match status 200 206 304
    }
    header @versionedOther {
        Cache-Control "public, max-age=2592000"
        match status 200 206 304
    }
    header @stableOther {
        # Explicit revalidation prevents heuristic caching of unversioned data.
        Cache-Control "no-cache"
        match status 200 206 304
    }
    # Reserved build paths never fall through to application workers.
    @buildAssets path {{.AssetPath}} {{.AssetPath}}/*
    handle @buildAssets {
        handle @assets {
            file_server {
                precompressed br zstd gzip
            }
        }
        handle {
            respond 404
        }
    }
    # Serve public assets directly, including vendor/ and Laravel public/storage.
    handle @staticFiles {
        file_server {
            precompressed br zstd gzip
        }
    }
    handle @otherFiles {
        file_server {
            precompressed br zstd gzip
        }
    }
    handle {
{{if eq .Type "laravel"}}
{{if eq .WebDriver "fpm"}}
        php_fastcgi unix/{{.FPMSocket}}
        file_server {
            precompressed br zstd gzip
        }
{{else}}
        reverse_proxy 127.0.0.1:{{.OctaneHTTPPort}}
{{end}}
{{else}}
        reverse_proxy 127.0.0.1:{{.NuxtHTTPPort}}
{{end}}
    }
    handle_errors {
        header {
            # File-serving errors must not retain public asset caching.
            -Cache-Control
            -Server
            -Via
            -X-Powered-By
            Strict-Transport-Security "max-age=15768000"
            X-Frame-Options "SAMEORIGIN"
            X-Content-Type-Options "nosniff"
            Referrer-Policy "strict-origin-when-cross-origin"
        }
        respond "{err.status_code}" {err.status_code}
    }
}
# Explicit HTTP routes also remove identifying headers from HTTPS redirects.
{{.HTTPDomains}} {
    header {
        -Server
        -Via
    }
    redir https://{host}{uri} 308
}
{{range .Aliases}}
{{.}} {
    header {
        -Server
        -Via
        -X-Powered-By
        Strict-Transport-Security "max-age=15768000"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    redir https://{{$.Domain}}{uri} 308
}
http://{{.}} {
    header {
        -Server
        -Via
    }
    redir https://{{$.Domain}}{uri} 308
}
{{end}}
