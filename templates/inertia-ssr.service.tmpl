# The application's SSR bundle must honor the managed host and port.
[Unit]
Description=Sites {{.Name}} Inertia SSR
After=network.target

[Service]
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0027
User={{.User}}
WorkingDirectory={{unitPath .Directory}}
EnvironmentFile={{unitPath .ManagedEnvironmentFile}}
ExecStart={{unit .PHPBinary}} artisan inertia:start-ssr --no-interaction
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
