# Draft: sites-{{.Name}}-inertia-ssr.service
# The application's SSR bundle must honor the managed host and port.
[Unit]
Description=Sites {{.Name}} Inertia SSR
After=network.target

[Service]
User={{.User}}
WorkingDirectory={{.Directory}}
EnvironmentFile={{.ManagedEnvironmentFile}}
ExecStart={{.PHPBinary}} artisan inertia:start-ssr --no-interaction
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
