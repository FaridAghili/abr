# The application's SSR bundle must honor the managed host and port.
[Unit]
Description=Abr {{.Name}} Inertia SSR
After=network.target

[Service]
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
# Long-running servers hold many sockets; systemd's 1024 soft limit is too low.
LimitNOFILE=65536
User={{.User}}
WorkingDirectory={{unitPath .Directory}}
EnvironmentFile={{unitPath .ManagedEnvironmentFile}}
ExecStart={{unit .PHPBinary}} artisan inertia:start-ssr --no-interaction
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
