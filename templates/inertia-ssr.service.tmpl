# The application's SSR bundle must honor the managed host and port.
[Unit]
Description=Abr {{.Name}} Inertia SSR
After=network.target

[Service]
Environment=PATH=/usr/local/bin:/usr/bin:/bin
UMask=0027
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
User={{.User}}
WorkingDirectory={{unitPath .Directory}}
EnvironmentFile={{unitPath .ManagedEnvironmentFile}}
ExecStart={{unit .PHPBinary}} artisan inertia:start-ssr --no-interaction
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
