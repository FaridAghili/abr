# Draft: sites-{{.Name}}-queue@.service (one instance per configured worker)
[Unit]
Description=Sites {{.Name}} queue worker %i
After=network.target

[Service]
User={{.User}}
WorkingDirectory={{.Directory}}
EnvironmentFile={{.ManagedEnvironmentFile}}
ExecStart={{.PHPBinary}} artisan queue:work --sleep=3 --tries=3 --timeout={{.QueueTimeout}} --no-interaction
Restart=on-failure
RestartSec=5
TimeoutStopSec={{.QueueStopTimeout}}

[Install]
WantedBy=multi-user.target
