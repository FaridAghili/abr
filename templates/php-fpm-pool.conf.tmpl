[abr-{{.Name}}]
user = {{.User}}
group = {{.User}}
listen = {{.FPMSocket}}
listen.owner = caddy
listen.group = caddy
listen.mode = 0660
pm = ondemand
; web.workers in the app's settings; children start on demand and exit when idle.
pm.max_children = {{.FPMChildren}}
pm.process_idle_timeout = 60s
pm.max_requests = 500
; Reclaim workers stuck on I/O, which max_execution_time does not count.
request_terminate_timeout = 300s
security.limit_extensions = .php
chdir = {{quote .Directory}}
clear_env = yes
{{.FPMEnvironment}}
