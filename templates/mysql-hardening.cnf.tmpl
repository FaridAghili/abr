# Managed by abr; edit the source template instead.
[mysqld]
bind-address = 127.0.0.1
mysqlx-bind-address = 127.0.0.1
local-infile = 0
# Keep password-based loopback root separate from root's auth_socket account.
skip-name-resolve = ON
# Modest shared-host defaults; size for measured workload and available RAM.
innodb_buffer_pool_size = 256M
# Instrumentation reserves hundreds of MB that a single app host rarely reads.
performance_schema = OFF
# Octane and queue workers hold connections for their whole lifetime.
max_connections = 200
thread_cache_size = 32
# Preserve transaction durability.
innodb_flush_log_at_trx_commit = 1
# Single host without replicas: backups are SQL dumps, so binary logs would only
# double commit fsyncs and fill the disk for 30 days.
disable_log_bin
