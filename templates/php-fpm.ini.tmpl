; Managed by abr; edit the source template instead.
max_execution_time = 60
post_max_size = 128M
upload_max_filesize = 100M
expose_php = Off
display_errors = Off
log_errors = On
; Shared FPM cache. Keep timestamp validation for in-place deployments.
opcache.enable = 1
; Sized for many Laravel apps; shared memory is only used as scripts are cached.
opcache.memory_consumption = 512
opcache.interned_strings_buffer = 64
opcache.max_accelerated_files = 200000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 2
opcache.jit = disable
